      "link": null,
      "locked": false,
      "text": "사람의 언어와 컴퓨터의 언어는 다른다.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "사람의 언어와 컴퓨터의 언어는 다른다.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "4odtMnKH6DQHSzqK3Xx44",
      "type": "text",
      "x": 285.9244689941406,
      "y": 163.75650024414062,
